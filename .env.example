# Independent political bot only. Never copy the technology channel's token.
APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./political-agent.db
OPENAI_API_KEY=
# Explicitly choose a model supporting Responses, Web Search and Structured Outputs.
OPENAI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
EXPECTED_BOT_USERNAME=
OWNER_CHAT_ID=0
CHANNEL_ID=
PUBLIC_BASE_URL=
ADMIN_API_TOKEN=
# Enable only after setup and private tests. Human approval remains mandatory.
PUBLISHING_ENABLED=false
WORKER_ENABLED=false
SCHEDULER_ENABLED=false
SCHEDULE_TIMES=
TIMEZONE=Asia/Tbilisi
# Editorial choices must be supplied by the owner. Example syntax, not a source recommendation.
SOURCE_DOMAINS=
SOURCE_ORIGIN_GROUPS={}
FORMAT_WORD_LIMITS={}
DEFAULT_FORMAT=STANDARD
MAX_DAILY_RUNS=4
MAX_DAILY_API_CALLS=24
MAX_OUTPUT_TOKENS=4000
MAX_SEARCH_CALLS=3
MAX_SOURCE_AGE_HOURS=48
DRAFT_TTL_MINUTES=120
HISTORY_DAYS=7
COMMONS_ENABLED=true
